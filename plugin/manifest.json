{
  "id": "com.garena.miccheck",
  "name": "Mic Check",
  "version": "1.3.1",
  "main": "index.html",
  "manifestVersion": 5,
  "host": {
    "app": "premierepro",
    "minVersion": "26.2.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "miccheck.panel",
      "label": {
        "default": "Mic Check"
      },
      "minimumSize": { "width": 200, "height": 80 },
      "maximumSize": { "width": 800, "height": 600 },
      "preferredDockedSize": { "width": 320, "height": 400 },
      "preferredFloatingSize": { "width": 320, "height": 400 },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/icon.png",
          "scale": [1, 2],
          "theme": ["darkest", "dark", "medium", "lightest", "light", "all"],
          "species": ["chrome"]
        }
      ]
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess"
  },
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/icon.png",
      "scale": [1, 2],
      "theme": ["darkest", "dark", "medium", "lightest", "light", "all"],
      "species": ["generic"]
    }
  ]
}
